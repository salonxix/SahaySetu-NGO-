# SahaySetu-NGO Environment Configuration Template
# Duplicate this file as .env.local for local development. Do not commit actual secrets.

# Application Base
NEXT_PUBLIC_APP_NAME="SahaySetu NGO"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Security (Min 32 characters for HS256 JWT signing)
AUTH_SECRET="sahaysetu-secure-development-secret-key-32chars!"

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
